{
  "id": "oh-mine-openclaw",
  "name": "Oh Mine OpenClaw",
  "description": "极简主义多 Agent 编排 — 3 个 Agent，3 个模式",
  "version": "0.1.0",
  "defaultConfig": {
    "agents": {
      "planner": {
        "model": "auto",
        "temperature": 0.7
      },
      "worker": {
        "model": "auto",
        "temperature": 0.3
      },
      "reviewer": {
        "model": "auto",
        "temperature": 0.2
      }
    },
    "modes": {
      "fast": ["worker"],
      "balanced": ["planner", "worker"],
      "thorough": ["planner", "worker", "reviewer"]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "agents": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "planner": {
            "type": "object",
            "properties": {
              "model": { "type": "string" },
              "temperature": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "worker": {
            "type": "object",
            "properties": {
              "model": { "type": "string" },
              "temperature": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "reviewer": {
            "type": "object",
            "properties": {
              "model": { "type": "string" },
              "temperature": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      },
      "modes": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fast": { "type": "array", "items": { "type": "string" } },
          "balanced": { "type": "array", "items": { "type": "string" } },
          "thorough": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
