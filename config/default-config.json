{
  "_comment": "Oh Mine OpenClaw 配置文件",
  "_docs": "模型可用 'auto' 自动选择，或指定具体模型如 'claude-sonnet-4-5'",
  
  "agents": {
    "planner": {
      "model": "auto",
      "temperature": 0.7,
      "_description": "任务规划师 — 拆解任务、给方案"
    },
    "worker": {
      "model": "auto",
      "temperature": 0.3,
      "_description": "执行者 — 实际干活"
    },
    "reviewer": {
      "model": "auto",
      "temperature": 0.2,
      "_description": "审查员 — 找问题、提建议"
    }
  },
  
  "modes": {
    "fast": ["worker"],
    "balanced": ["planner", "worker"],
    "thorough": ["planner", "worker", "reviewer"]
  }
}
